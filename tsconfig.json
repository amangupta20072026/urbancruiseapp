{
  "extends": "@react-native/typescript-config",

  "compilerOptions": {
    "types": ["jest"],

    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@config/*": ["./src/config/*"],
      "@constants/*": ["./src/constants/*"],
      "@theme": ["./src/theme"],
      "@theme/*": ["./src/theme/*"],
      "@assets/*": ["./src/assets/*"],
      "@shared/*": ["./src/features/shared/*"],
      "@api/*": ["./src/api/*"],
      "@services/*": ["./src/services/*"],
      "@store": ["./src/store"],
      "@store/*": ["./src/store/*"],
      "@rbac/*": ["./src/rbac/*"],
      "@navigation/*": ["./src/navigation/*"],
      "@app-types/*": ["./src/types/*"],
      "@features/*": ["./src/features/*"],
      "@components/*": ["./src/components/*"],
      "@mocks/*": ["./src/mocks/*"],
    }
  },

  "include": ["**/*.ts", "**/*.tsx"],

  "exclude": ["**/node_modules", "**/Pods"]
}