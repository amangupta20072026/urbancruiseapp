<?xml version="1.0" encoding="utf-8"?>
<!--
  Resource-shrinker keep rules (used because release builds set
  shrinkResources). React Native copies every image `require()`d in
  JavaScript into res/drawable-* and res/raw, then loads them BY NAME
  at runtime (Resources.getIdentifier). The shrinker cannot see those
  lookups, so without these rules it could strip images that are in
  use and they would disappear in release builds only.

  Names are generated from the asset's path: files under src/ become
  "src_…", files from packages become "node_modules_…".
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/src_*,@drawable/node_modules_*,@raw/*" />
