<?xml version="1.0" encoding="utf-8"?>
<!--
  Resource-shrinker keep rules for app.urbancruise (release builds set
  shrinkResources).

  WHY: React Native copies every image `require()`d in JavaScript into
  res/drawable-* (fonts and other files into res/raw) and loads them BY
  NAME at runtime via Resources.getIdentifier()
  (ReactAndroid: views/imagehelper/ResourceDrawableIdHelper.kt). The
  shrinker cannot see those lookups, so these rules keep them.

  NAMES: generated by getAndroidResourceIdentifier() in
  @react-native/assets-registry/path-support.js from Metro's default
  publicPath "/assets": files under src/ become "src_…", files from
  packages become "node_modules_…".

  FILE NAME: keep files have global scope; Android docs recommend a
  unique, package-qualified name so a library's keep file can't
  override or conflict with this one.
  https://developer.android.com/topic/performance/app-optimization/customize-which-resources-to-keep
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/src_*,@drawable/node_modules_*,@raw/*" />